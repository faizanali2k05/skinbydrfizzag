# The Flutter app source is tracked. Build artifacts, generated files and
# secrets are excluded by skinbydrfizzag/.gitignore (and the per-platform ones).

# Ignore environment variables
.env
.env.local
.env.*.local
*.env
.env.*

# Ignore IDE and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Ignore logs
*.log

# Ignore PRD (kept locally, not committed)
prd.md
